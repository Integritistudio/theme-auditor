{
  "name": "shopify-app-template-node",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "debug": "node --inspect-brk index.js",
    "dev": "cross-env NODE_ENV=development nodemon index.js --ext js,mjs,json,ts --ignore ./frontend",
    "serve": "cross-env NODE_ENV=production node index.js",
    "db:migrate": "node --input-type=module -e \"import { runMigrations } from './db/migrate.ts'; runMigrations().then(() => process.exit(0)).catch((err) => { console.error(err); process.exit(1); });\"",
    "test": "node --test scoring/engine.test.ts scanners/performance/extract-sections.test.ts scanners/themes/rules/duplicate-script.test.ts",
    "test:scoring": "node --test scoring/engine.test.ts",
    "test:performance": "node --test scanners/performance/extract-sections.test.ts",
    "test:theme-dupes": "node --test scanners/themes/rules/duplicate-script.test.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=16.13.0"
  },
  "dependencies": {
    "@shopify/shopify-app-express": "^8.0.1",
    "@shopify/shopify-app-session-storage-postgresql": "^7.0.1",
    "@shopify/shopify-app-session-storage-sqlite": "^4.0.8",
    "@types/pg": "^8.23.1",
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "serve-static": "^1.14.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^2.0.15",
    "prettier": "^2.6.2",
    "pretty-quick": "^3.1.3"
  }
}
